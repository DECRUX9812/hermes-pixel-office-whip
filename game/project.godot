; Engine configuration file.
; HERMES: THE LAST OPEN DOOR — vertical-slice foundation.
; Godot 4.7.1, Forward+, typed GDScript. Blockout layer is replaceable.

config_version=5

[application]

config/name="Hermes: The Last Open Door"
config/description="Vertical-slice foundation for Chapter 2: The Choir Below."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
GameState="*res://src/autoload/game_state.gd"
CheckpointManager="*res://src/autoload/checkpoint_manager.gd"
Settings="*res://src/autoload/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

